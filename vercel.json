{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/demo/analyze",
      "destination": "/api/health.py"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/api/health.py"
    },
    {
      "source": "/signal/(.*)",
      "destination": "/api/health.py"
    },
    {
      "source": "/ops/(.*)",
      "destination": "/api/health.py"
    },
    {
      "source": "/docs",
      "destination": "/api/health.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/health.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/health.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    }
  ]
}
