{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/demo/analyze",
      "destination": "/api/demo/analyze.py"
    },
    {
      "source": "/signal/decide",
      "destination": "/api/signal/decide.py"
    },
    {
      "source": "/signal/preview",
      "destination": "/api/signal/preview.py"
    },
    {
      "source": "/ops/logs",
      "destination": "/api/ops/logs.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    }
  ]
}
