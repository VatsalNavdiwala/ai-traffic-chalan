{
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/demo/analyze",
      "dest": "/api/index.py"
    },
    {
      "src": "/demo/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/signal/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/ops/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/redoc",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/traffic_ai/dashboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/traffic_ai/dashboard/$1"
    }
  ]
}
