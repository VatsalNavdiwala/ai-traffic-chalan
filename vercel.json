{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/signal/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/demo/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/ops/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/traffic_ai/dashboard/:path*"
    }
  ]
}
