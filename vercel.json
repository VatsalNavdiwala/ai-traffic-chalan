{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/api/demo/$1"
    },
    {
      "source": "/signal/(.*)",
      "destination": "/api/signal/$1"
    },
    {
      "source": "/ops/(.*)",
      "destination": "/api/ops/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/traffic_ai/dashboard/$1"
    }
  ]
}
